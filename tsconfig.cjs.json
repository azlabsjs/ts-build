{
  "comment": "See https://www.typescriptlang.org/tsconfig to better understand tsconfigs",
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules/**/*",
    "lib",
    "dist"
  ],
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": [
      "dom",
      "esnext"
    ],
    "importHelpers": true,
    
    // Output & Directories
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationDir": "./lib/types",
    "rootDir": "./src",
    "outDir": "./lib/cjs",
    "sourceMap": true,

    // Strictness & Linter options
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Module Resolution
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // JSX
    "jsx": "react",

    // Performance & Safety
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}