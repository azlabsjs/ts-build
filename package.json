{
  "name": "@azlabsjs/ts-build",
  "version": "0.6.6",
  "description": "Typescript library generator package",
  "main": "./lib/cjs/index.js",
  "typings": "./lib/types/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "lint": "eslint ./src/**",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "rimraf lib/ && npm run build:ts",
    "build:types": "tsc --emitDeclarationOnly",
    "build:ts": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "start": "tsc ./src/index.ts --watch",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "author": "azandrew-sidoine",
  "license": "MIT",
  "bin": {
    "ts-build": "lib/cjs/build.js"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "chalk": "^4.1.2",
    "core-js": "^3.38.0",
    "eslint": "^9.30.0",
    "fs-extra": "^11.3.0",
    "jsonfile": "^6.1.0",
    "progress-estimator": "^0.3.1",
    "ramda": "^0.31.3",
    "rollup": "^4.44.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "sade": "^1.8.1",
    "semver": "^7.7.2",
    "structured-clone-polyfill": "^0.0.2",
    "tiny-glob": "^0.2.9",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@rollup/pluginutils": "^5.1.0",
    "@size-limit/preset-small-lib": "^11.1.4",
    "@types/eslint": "^8.56.10",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonfile": "^6.1.4",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "rimraf": "^6.1.4",
    "size-limit": "^11.1.4",
    "typescript": ">=4.8.4 | <6.1.0"
  },
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    }
  },
  "size-limit": [
    {
      "path": "lib/cjs/index.js",
      "limit": "24 KB"
    },
    {
      "path": "lib/esm/index.js",
      "limit": "24 KB"
    }
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@azlabsjs"
  }
}
